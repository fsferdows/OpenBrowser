{
  "name": "agentic-browser-workspace",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "agentic-browser-workspace",
      "version": "0.1.0",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=20.0.0",
        "npm": ">=9.0.0"
      }
    },
    "node_modules/@agentic-browser/control": {
      "resolved": "packages/control",
      "link": true
    },
    "node_modules/@agentic-browser/gateway": {
      "resolved": "packages/gateway",
      "link": true
    },
    "node_modules/@agentic-browser/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "packages/control": {
      "name": "@agentic-browser/control",
      "version": "0.1.0",
      "dependencies": {
        "@agentic-browser/shared": "0.1.0"
      }
    },
    "packages/gateway": {
      "name": "@agentic-browser/gateway",
      "version": "0.1.0",
      "dependencies": {
        "@agentic-browser/shared": "0.1.0"
      }
    },
    "packages/shared": {
      "name": "@agentic-browser/shared",
      "version": "0.1.0"
    }
  }
}
