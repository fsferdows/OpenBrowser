{
  "name": "openbrowser",
  "version": "1.0.0",
  "description": "OpenBrowser - The Production Autonomous AI Agentic Browser for Hackers & Power Users",
  "author": "FS Ferdows <fsferdows@icloud.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/fsferdows/OpenBrowser.git"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node scripts/serve-localhost.mjs",
    "dev": "node scripts/serve-localhost.mjs",
    "browser:brave": "bash scripts/launch-brave-cdp.sh",
    "browser:chrome": "bash scripts/launch-chrome-cdp.sh",
    "test": "node --test --test-force-exit packages/*/tests/*.test.js packages/*/tests/**/*.test.js",
    "lint": "node scripts/lint.mjs",
    "typecheck": "node scripts/typecheck-stub.mjs",
    "security:scan": "node scripts/scan-secrets.mjs",
    "licenses:audit": "node scripts/audit-licenses.mjs",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "slo:verify": "node scripts/verify-slo-budgets.mjs",
    "ci": "npm run security:scan && npm run licenses:audit && npm run lint && npm run slo:verify && npm run test"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
